# Google Ads API credentials
# Create OAuth credentials in Google Cloud Console and a developer token in Google Ads.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=

# Customer IDs may be entered with or without hyphens.
# Login customer ID is optional and is only needed for manager-account access.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
